{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AHK: Run in terminal (stdout visible)",
      "type": "shell",
      "command": "& \"C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe\" \"/ErrorStdOut\" \"${file}\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
